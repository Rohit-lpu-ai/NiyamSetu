# NiyamSetu — environment configuration EXAMPLE
#
# Copy to `.env` and fill in. `.env` is git-ignored; this file is committed
# with placeholders only. Never put a real password in this file.
#
#   cp .env.example .env
#
# Either set the complete URL:
# NIYAMSETU_DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/niyamsetu
#
# ...or set the parts and let the code assemble it (the password is
# percent-encoded for you, so '@' and '/' in a password are safe):
NIYAMSETU_DB_HOST=localhost
NIYAMSETU_DB_PORT=5432
NIYAMSETU_DB_NAME=niyamsetu
NIYAMSETU_DB_USER=postgres
NIYAMSETU_DB_PASSWORD=replace-me

# The throwaway database the tests may create, truncate and drop.
# MUST be a different database from the one above, and its name MUST contain
# 'test' — backend/app/db/config.py refuses to run destructive tests otherwise.
# Leave unset and the database tests skip themselves rather than guessing.
NIYAMSETU_TEST_DATABASE_URL=postgresql+psycopg://postgres:replace-me@localhost:5432/niyamsetu_test
